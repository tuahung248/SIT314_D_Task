# MQTT Broker
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_BROKER_TLS_URL=mqtts://localhost:8883

# AWS IoT Core (production)
AWS_IOT_ENDPOINT=your-endpoint.iot.ap-southeast-2.amazonaws.com
AWS_IOT_CERT_PATH=./certs/device-cert.pem
AWS_IOT_KEY_PATH=./certs/device-key.pem
AWS_IOT_CA_PATH=./certs/root-ca.pem

# MongoDB
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/smart_home_lighting?retryWrites=true&w=majority

# SQS
AWS_SQS_QUEUE_URL=https://sqs.ap-southeast-2.amazonaws.com/123456789012/smart-home-sensor-queue
AWS_REGION=ap-southeast-2

# Notification Service
WEBHOOK_URL=https://webhook.site/your-unique-id
NOTIFICATION_EMAIL_FROM=noreply@smarthome.example.com

# Simulation
NUM_BUILDINGS=1
ROOMS_PER_BUILDING=5
PUBLISH_INTERVAL_MS=1000
